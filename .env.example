# 複製為 .env 後修改。.env 不可 commit。

# PostgreSQL + TimescaleDB
POSTGRES_USER=rms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rms
DATABASE_URL=postgres://rms:change-me@localhost:5432/rms

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
EMQX_DASHBOARD_PASSWORD=change-me

# 物件儲存（SeaweedFS，S3 相容）
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=rms
S3_SECRET_KEY=change-me-too
S3_BUCKET=rms

# MediaMTX
MEDIAMTX_API=http://localhost:9997
STREAM_TOKEN_TTL_SEC=60

# Auth
JWT_SECRET=please-generate-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 人臉系統（文件待提供）
FACE_API_BASE=
FACE_API_KEY=

# 轉接器：X30 導航主機（每台一個，見 adapters/deep_x30/robots.example.yaml）
X30_DEFAULT_PORT=30000
