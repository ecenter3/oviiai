# 複製為 .env 後修改。.env 不可 commit。

# PostgreSQL + TimescaleDB
POSTGRES_USER=rms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rms
DATABASE_URL=postgres://rms:change-me@localhost:5432/rms

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
EMQX_DASHBOARD_PASSWORD=change-me

# 物件儲存（SeaweedFS，S3 相容）
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=rms
S3_SECRET_KEY=change-me-too
S3_BUCKET=rms
# 瀏覽器下載用的預簽名網址主機（正式環境經 Nginx）；沒設就用 S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=http://localhost:8333

# MediaMTX（docker compose --profile media up）
MEDIAMTX_API=http://localhost:9997
# 後端抓拍、錄影讀 RTSP 的位址
MEDIAMTX_RTSP=rtsp://localhost:8554
# 瀏覽器播放（WHEP）的位址：開發直連 8889；正式環境由 Nginx 轉 /media（例 https://rms.example.local/media）
MEDIA_PUBLIC_URL=http://localhost:8889
# 轉接器拉對講音訊（T-31 方案 A）時連的 MediaMTX RTSP；轉接器在另一台主機時改成那台看得到的位址（預設同 MEDIAMTX_RTSP）
# MEDIA_ADAPTER_RTSP=rtsp://192.168.10.5:8554
# 後端與測試影像源讀寫 MediaMTX 的內部帳號（openssl rand -hex 16）；正式環境必填
MEDIA_INTERNAL_USER=rms-internal
MEDIA_INTERNAL_PASSWORD=
# 沒有影像來源時用測試畫面（開發預設 true、正式環境預設 false）
# MEDIA_TEST_SOURCE=true
STREAM_TOKEN_TTL_SEC=60
# ffmpeg 位置：預設用 ffmpeg-static 套件；正式映像檔用 apt 裝的 ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg

# Auth
# JWT_SECRET 至少 32 字元，用 openssl rand -base64 48 產生。NODE_ENV=production 時沿用預設值或太短會拒絕啟動
JWT_SECRET=please-generate-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 本機 http 開發設 false；正式環境走 HTTPS 必須是 true（預設）
COOKIE_SECURE=false

# 資料加密（攝影機 RTSP 帳密、機器人連線密碼），至少 32 字元：openssl rand -base64 48
DATA_ENC_KEY=

# 轉接器向後端取設定（GET /api/v1/adapter-config/{name}）的金鑰，至少 16 字元。名稱大寫：ADAPTER_KEY_MOCK、ADAPTER_KEY_ANBOT…
# 可以取轉接器設定的來源網段（轉接器主機所在網段）。正式環境沒設 = 一律拒絕
ADAPTER_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# 前面有 Nginx 時設成 Nginx 的位址（例 172.18.0.0/16），後端才拿得到真正的來源 IP；預設只信任本機
# TRUST_PROXY=loopback
ADAPTER_KEY_MOCK=
ADAPTER_KEY_ANBOT=
ADAPTER_KEY_UNITREE=
ADAPTER_KEY_DEEP=

# 初始系統管理員（make seed 建立；帳號已存在則不變更）。密碼至少 8 碼，含英文與數字
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 人臉系統（文件待提供）
FACE_API_BASE=
FACE_API_KEY=

# 轉接器：X30 導航主機（每台一個，見 adapters/deep_x30/robots.example.yaml）
X30_DEFAULT_PORT=30000
