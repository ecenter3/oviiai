# 複製為 .env 後修改。.env 不可 commit。

# PostgreSQL + TimescaleDB
POSTGRES_USER=rms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rms
DATABASE_URL=postgres://rms:change-me@localhost:5432/rms

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
EMQX_DASHBOARD_PASSWORD=change-me

# 物件儲存（SeaweedFS，S3 相容）
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=rms
S3_SECRET_KEY=change-me-too
S3_BUCKET=rms

# MediaMTX
MEDIAMTX_API=http://localhost:9997
STREAM_TOKEN_TTL_SEC=60

# Auth
# JWT_SECRET 至少 32 字元，用 openssl rand -base64 48 產生。NODE_ENV=production 時沿用預設值或太短會拒絕啟動
JWT_SECRET=please-generate-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 本機 http 開發設 false；正式環境走 HTTPS 必須是 true（預設）
COOKIE_SECURE=false

# 資料加密（攝影機 RTSP 帳密、機器人連線密碼），至少 32 字元：openssl rand -base64 48
DATA_ENC_KEY=

# 轉接器向後端取設定（GET /api/v1/adapter-config/{name}）的金鑰，至少 16 字元。名稱大寫：ADAPTER_KEY_MOCK、ADAPTER_KEY_ANBOT…
ADAPTER_KEY_MOCK=
ADAPTER_KEY_ANBOT=
ADAPTER_KEY_UNITREE=
ADAPTER_KEY_DEEP=

# 初始系統管理員（make seed 建立；帳號已存在則不變更）。密碼至少 8 碼，含英文與數字
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 人臉系統（文件待提供）
FACE_API_BASE=
FACE_API_KEY=

# 轉接器：X30 導航主機（每台一個，見 adapters/deep_x30/robots.example.yaml）
X30_DEFAULT_PORT=30000
